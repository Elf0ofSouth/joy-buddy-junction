# ============================================================
# Cipher Project — variáveis de ambiente
#
# Este arquivo é só um modelo. O .env de verdade está no
# .gitignore e NUNCA deve ser commitado.
#
# Em produção, defina tudo em: Vercel -> Settings -> Environment
# Variables (e depois force um Redeploy: variável nova só passa a
# valer no próximo build).
# ============================================================

# ---- Supabase: público (vai para o bundle do navegador) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ---- Supabase: servidor (SSR) ----
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# ---- Supabase: SEGREDO ----
# Ignora o RLS. Nunca prefixe com VITE_ e nunca use no código do site:
# o Vite embute qualquer VITE_* no bundle público.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cipher: painel de licenças ----
# Senha do painel em /admin.html. Use algo longo e aleatório.
CIPHER_ADMIN_TOKEN=

# ---- Cipher: opcionais ----
# Chave da Claude API, usada pelo botão "Otimizar prompt" da extensão.
# Sem ela, aquele botão responde 501 e o resto funciona normal.
ANTHROPIC_API_KEY=
# Link mostrado quando a key está presa em outro dispositivo.
CIPHER_RESET_PAGE_URL=
# Modelo usado na otimização de prompt.
CIPHER_AI_MODEL=claude-opus-5
